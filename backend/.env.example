# Application
APP_NAME=Autonomous Support AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Logging
LOG_LEVEL=INFO

# PostgreSQL (runs via Docker — see docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=rag_chatbot

# Weaviate (runs via Docker — see docker-compose.yml)
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
