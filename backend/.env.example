# Application
APP_NAME=Autonomous Support AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Logging
LOG_LEVEL=INFO

# PostgreSQL (runs via Docker — see docker-compose.yml)
# These values are for running the BACKEND LOCALLY against the Docker
# database (host port 5433). When the backend itself runs in Docker,
# docker-compose.yml overrides POSTGRES_HOST=postgres / PORT=5432 — so
# one file works for both, and you should not "fix" these for Docker.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=rag_chatbot

# Weaviate (runs via Docker — see docker-compose.yml)
# Same as above: overridden to WEAVIATE_HOST=weaviate inside Docker.
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051

# Redis — hot session-memory cache (runs via Docker — see docker-compose.yml)
# For local Option B: keep REDIS_URL pointing at localhost:6379.
# docker-compose.yml overrides to redis://redis:6379/0 for the containerised backend.
# If SESSION_MEMORY_ENABLED=false the Redis layer is skipped entirely and every
# request falls back to PostgreSQL — chat still works, just without the cache.
REDIS_URL=redis://localhost:6379/0
SESSION_MEMORY_ENABLED=true
SESSION_MEMORY_TTL_SECONDS=86400
SESSION_MEMORY_MAX_MESSAGES=20


# --- Authentication ---
# How long a login session stays valid, in seconds. This is an INACTIVITY
# timeout, not an absolute one: every authenticated request slides the
# expiry forward. Sessions live in the `user_sessions` PostgreSQL table,
# not Redis, so nothing here depends on the cache being up.
# The admin/demo accounts are seeded automatically at startup
# (admin/admin123, demo/demo123) — see app/services/auth_service.py.
AUTH_SESSION_TTL_SECONDS=86400

# Groq — GROQ_API_KEY is tried first; on a rate-limit (429) the client
# automatically falls through to GROQ_API_1, then _2, then _3, in order.
# All optional — set only the ones you have.
GROQ_API_KEY=
GROQ_API_1=
GROQ_API_2=
GROQ_API_3=
GROQ_MODEL=openai/gpt-oss-120b

# --- Retrieval / chunking (all optional; defaults shown) ---
# Chunking applies at UPLOAD time only — changing it does not re-chunk
# already-uploaded documents. See "Choosing a chunk size" in
# backend/README.md before lowering these: too-small chunks split a
# sentence stating two rules and cause answers to claim the documents
# omit things they actually state.
CHUNK_SIZE_TOKENS=100
CHUNK_OVERLAP_TOKENS=10

# BGE-Reranker-v2-M3 in the /api/v1/chat graph. Off by default: measured
# ~3x the latency for no score gain on this corpus.
RERANK_ENABLED=false
RERANK_TOP_K=10
