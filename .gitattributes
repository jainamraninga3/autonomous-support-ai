# Shell scripts must keep LF endings even when checked out on Windows.
#
# This is not cosmetic: if git converts entrypoint.sh to CRLF, the Linux
# container fails at startup with the famously unhelpful
#   exec /app/entrypoint.sh: no such file or directory
# because the kernel reads the shebang as "/bin/sh\r", which doesn't exist.
*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
